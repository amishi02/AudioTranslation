# Real-Time Audio Translation — Backend Environment Template
# Copy to .env and adjust for local development. Never commit .env.
# Every dynamic value is env-configurable — no hard-coded URLs/paths/model names in code.

# --- Core ---
APP_NAME=Real-Time Audio Translation API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Network / Paths ---
# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WebSocket and API prefixes — change only if you need a different path/version
WS_V1_PATH=/ws/v1/translate
API_V1_PREFIX=/api/v1
HEALTH_PATH=/health
HEALTH_READY_PATH=/health/ready

# --- Capabilities ---
# Supported language codes (comma-separated ISO 639-1)
SUPPORTED_LANGUAGES=en,hi,es,fr,de

# --- Pipeline ---
# Pipeline type: cascaded (STT→Translation→TTS) or unified (direct speech translation)
PIPELINE_TYPE=cascaded

# Provider selection — use real providers in runtime; mock is for tests only.
STT_PROVIDER=whisper
TRANSLATION_PROVIDER=mock
TTS_PROVIDER=mock
UNIFIED_PROVIDER=mock

# --- Model / Device (Phase 7-9) ---
# Use faster-whisper alias tiny/base/small/medium; base (74M) is best balance for real-time multilingual
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Translation: Helsinki-NLP Opus-MT per-pair or NLLB multilingual
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-hi
TRANSLATION_DEVICE=cpu
TRANSLATION_MAX_LENGTH=128
TRANSLATION_NUM_BEAMS=1
# Optional pair map for Opus multi-pair (JSON string or comma-separated en-hi,hi-en)
TRANSLATION_PAIR_MAP=
# Unified speech translation (e.g., SeamlessStreaming — note CC-BY-NC-4.0 licensing)
UNIFIED_MODEL=facebook/seamless-streaming
UNIFIED_DEVICE=cpu
# TTS (e.g., Piper ONNX — MIT, fast CPU)
TTS_MODEL=piper:en_US-lessac-medium
TTS_DEVICE=cpu
TTS_SAMPLE_RATE=22050
UNIFIED_TARGET_SAMPLE_RATE=16000

# --- Audio / WebSocket (Phase 4-5) ---
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=60
AUDIO_QUEUE_MAXSIZE=128
MAX_AUDIO_FRAME_BYTES=65536
MAX_JSON_BYTES=65536

# --- Observability ---
METRICS_ENABLED=false

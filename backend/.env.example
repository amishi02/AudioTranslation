# Real-Time Audio Translation — Backend Environment Template
# Copy to .env and adjust for local development. Never commit .env.

# --- Core ---
APP_NAME=Real-Time Audio Translation API
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated origins (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phase-2+ placeholders (uncomment when needed) ---
# PIPELINE_TYPE=cascaded
# STT_PROVIDER=mock
# TRANSLATION_PROVIDER=mock
# TTS_PROVIDER=mock
# UNIFIED_PROVIDER=mock

# --- Model / Device placeholders (Phase 7-9) ---
# STT_MODEL=openai/whisper-small
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-hi
# UNIFIED_MODEL=facebook/seamless-streaming
# TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC

# --- Audio placeholders (Phase 5) ---
# AUDIO_TARGET_SAMPLE_RATE=16000
# AUDIO_CHANNELS=1
# AUDIO_CHUNK_MS=60
# AUDIO_QUEUE_MAXSIZE=64
# MAX_AUDIO_FRAME_BYTES=65536
# MAX_JSON_BYTES=65536

# --- Observability ---
# METRICS_ENABLED=false

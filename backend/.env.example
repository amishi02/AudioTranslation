# Real-Time Audio Translation — Backend Environment Template
# Copy to .env and adjust for local development. Never commit .env.
# Every dynamic value is env-configurable — no hard-coded URLs/paths/model names in code.
APP_NAME=Real-Time Audio Translation API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WS_V1_PATH=/ws/v1/translate
API_V1_PREFIX=/api/v1
HEALTH_PATH=/health
HEALTH_READY_PATH=/health/ready
SUPPORTED_LANGUAGES=en,hi,es,fr,de
# PIPELINE_TYPE=unified 
PIPELINE_TYPE=cascaded
# Free open-source models — change only this line to switch, no code change needed
STT_PROVIDER=whisper
TRANSLATION_PROVIDER=opus
TTS_PROVIDER=mock
UNIFIED_PROVIDER=mock
# Base — best balance for real-time multilingual (74M, ~150MB, better quality than tiny, still real-time on CPU int8)
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MIN_DECODE_SECONDS=1.0
STT_VAD_FILTER=true
STT_VAD_MIN_SPEECH_MS=250
STT_VAD_MIN_SILENCE_MS=500
STT_VAD_SPEECH_PAD_MS=100
STT_NO_SPEECH_THRESHOLD=0.6
# Opus-MT pair template; the provider fills {src} and {tgt} per session.
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-{src}-{tgt}
TRANSLATION_DEVICE=cpu
UNIFIED_MODEL=facebook/seamless-streaming
UNIFIED_DEVICE=cpu
TTS_MODEL=tts_models/en/ljspeech/tacotron2-DDC
TTS_DEVICE=cpu
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=60
AUDIO_QUEUE_MAXSIZE=128
MAX_AUDIO_FRAME_BYTES=65536
MAX_JSON_BYTES=65536
SESSION_IDLE_TIMEOUT_MS=15000
SESSION_MAX_DURATION_MS=600000
WS_MAX_QUEUE_DEPTH=64
RATE_LIMIT_FRAMES_PER_SECOND=50
RATE_LIMIT_BYTES_PER_SECOND=320000
STT_WINDOW_FINAL_EVERY_S=2.5
STT_PARTIAL_THROTTLE_MS=300
STT_LIVE_WINDOW_S=1.5
PERF_ENABLED=false
METRICS_ENABLED=false

# Real-Time Audio Translation — Frontend Environment Template
# Copy to .env and adjust for local development. Never commit .env with secrets.
# Every dynamic URL/path is env-configurable — no hard-coded backend URLs in code.

# HTTP API base (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL (ws:// for dev, wss:// for production — must match backend WS_V1_PATH)
VITE_WS_URL=ws://localhost:8000/ws/v1/translate

# API paths (must match backend API_V1_PREFIX / HEALTH_PATH)
VITE_API_V1_PREFIX=/api/v1
VITE_HEALTH_PATH=/health
VITE_HEALTH_READY_PATH=/health/ready
VITE_CAPABILITIES_PATH=/api/v1/capabilities

# Optional polling / UX tuning
VITE_HEALTH_POLL_INTERVAL_MS=30000
VITE_APP_TITLE=Real-Time Audio Translation

# Build / log
VITE_LOG_LEVEL=info
